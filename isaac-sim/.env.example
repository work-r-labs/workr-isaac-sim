# Copy to .env (gitignored) and fill in. A read-only service-account
# token, scoped to the one project this instance mirrors.
WORKR_TOKEN=
PROJECT_ID=

# Version of @workr-labs/sync to run. Pin it: this is the code that
# writes into the scenes volume, and an unpinned spec re-resolves on
# every container restart.
SYNC_VERSION=

# Seconds to wait after a run finishes before starting the next.
# Optional, defaults to 60.
SYNC_INTERVAL_SECONDS=
